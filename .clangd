CompileFlags:
    Compiler: x86_64-elf-gcc
    Add:
        - -std=gnu11
        - -ffreestanding
        - -D__is_kernel
        - -I/home/bobywoby/dev/c/nyaos/kernel/include
        - -I/home/bobywoby/dev/c/nyaos/libc/include
        - -Wall
        - -Wextra
    # clangd parses with its bundled clang; drop gcc-only flags it rejects
    Remove:
        - -mno-80387
        - -mno-mmx
        - -mcmodel=kernel
